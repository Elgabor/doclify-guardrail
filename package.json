{
  "name": "doclify-guardrail",
  "version": "2.0.0-beta.2",
  "type": "module",
  "description": "Deterministic, local, read-only documentation integrity checks for Markdown repositories.",
  "homepage": "https://github.com/Elgabor/doclify-guardrail#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Elgabor/doclify-guardrail.git"
  },
  "bugs": {
    "url": "https://github.com/Elgabor/doclify-guardrail/issues"
  },
  "files": [
    "src/",
    "README.md",
    "MIGRATION.md",
    "examples/evidence-demo/"
  ],
  "exports": {
    "./api": "./src/api.mjs"
  },
  "bin": {
    "doclify-guardrail": "src/index.mjs"
  },
  "scripts": {
    "start": "node ./src/index.mjs",
    "test": "npm run test:correctness && npm run test:labeled",
    "test:correctness": "node ./scripts/check-test-isolation.mjs",
    "test:labeled": "node ./scripts/check-labeled-correctness.mjs",
    "test:network": "node ./scripts/check-network-boundary.mjs",
    "test:performance": "node ./scripts/perf-corpus.mjs",
    "docs:sync-check": "node ./scripts/check-docs-sync.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "keywords": [
    "markdown",
    "lint",
    "documentation",
    "quality",
    "guardrail",
    "cli"
  ]
}
